{
  "manifest_version": 3,
  "name": "Amazon Account Detector",
  "version": "1.1.0",
  "description": "See which Amazon account is signed in on every marketplace, live, without touching your tabs.",
  "minimum_chrome_version": "116",
  "permissions": ["alarms", "cookies", "notifications", "offscreen", "sidePanel", "storage"],
  "host_permissions": [
    "https://amazon.com/*",
    "https://www.amazon.com/*",
    "https://amazon.co.uk/*",
    "https://www.amazon.co.uk/*",
    "https://amazon.de/*",
    "https://www.amazon.de/*",
    "https://amazon.it/*",
    "https://www.amazon.it/*",
    "https://amazon.fr/*",
    "https://www.amazon.fr/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Amazon Account Detector",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": { "default_path": "board.html?view=panel" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "omnibox": { "keyword": "amz" },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
