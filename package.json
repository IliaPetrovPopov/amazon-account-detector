{
  "name": "amazon-account-detector",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome MV3 extension that shows which Amazon account is signed in on each marketplace, without touching your tabs.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "npm run build && node e2e/run.mjs",
    "icons": "node scripts/make-icons.mjs",
    "showcase": "npm run build && node e2e/showcase.mjs",
    "verify": "npm run typecheck && npm test && npm run build && node scripts/check-dist.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@types/chrome": "0.3.7",
    "@types/jsdom": "30.0.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
